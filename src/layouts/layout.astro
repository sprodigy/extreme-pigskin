---
import "../styles/style.css";
import Nav from "../components/Nav.astro";

const { title = "Extreme Pigskin" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <title>{title} | Extreme Pigskin</title>
  </head>

  <body>
    <header class="site-header">
  <a href="/" class="site-logo-link" aria-label="Extreme Pigskin home">
    <img
      src="/images/logo.png"
      alt="Extreme Pigskin logo"
      class="site-logo"
    />
  </a>

  <div class="site-branding">
    <div class="site-title">Extreme Pigskin</div>
    <div class="site-subtitle">Fantasy Football League Since 2010</div>
  </div>
</header>

    <Nav />

    <main>
      <slot />
    </main>
  </body>
</html>