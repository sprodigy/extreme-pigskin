---
import { getGameLog, getOwners } from "../lib/data";
import {
  getOwnerList,
  getHeadToHeadStats,
  shortOwnerName
} from "../lib/stats";
import Layout from "../layouts/layout.astro";

const gameLog = getGameLog();
const owners = getOwnerList(gameLog);
const ownerStatuses = getOwners();

const activeOwnerNames = ownerStatuses
  .filter(owner => owner.status === "ACTIVE")
  .map(owner => owner.owner);

const ownerDisplayNames = {};

for (const owner of owners) {
  ownerDisplayNames[owner.owner] = shortOwnerName(owner.owner);
}

const matchupStats = {};

for (const ownerA of owners) {
  for (const ownerB of owners) {
    if (ownerA.owner === ownerB.owner) continue;

    const key = `${ownerA.owner}|||${ownerB.owner}`;
    matchupStats[key] = getHeadToHeadStats(gameLog, ownerA.owner, ownerB.owner);
  }
}
---

<Layout title="Head-To-Head">
  <h1>Head-to-Head Matchup &#9876;</h1>

  <div class="page-card">
    <h2>Matchup Finder</h2>

    <label class="filter-checkbox">
      <input type="checkbox" id="current-owners-only" />
      Current owners only
    </label>

    <div class="owner-select-grid">
      <div>
        <label for="owner-a">Owner A</label>
        <select id="owner-a">
          <option value="">Choose owner...</option>
          {
            owners.map(owner => (
              <option value={owner.owner}>{owner.owner}</option>
            ))
          }
        </select>
      </div>

      <div>
        <label for="owner-b">Owner B</label>
        <select id="owner-b">
          <option value="">Choose owner...</option>
          {
            owners.map(owner => (
              <option value={owner.owner}>{owner.owner}</option>
            ))
          }
        </select>
      </div>
    </div>

    <div id="results"></div>

      <script define:vars={{ matchupStats, owners, activeOwnerNames, ownerDisplayNames }}>
        const ownerASelect = document.getElementById("owner-a");
        const ownerBSelect = document.getElementById("owner-b");
        const currentOwnersOnly = document.getElementById("current-owners-only");
        const results = document.getElementById("results");

        const allOwners = owners.map(owner => owner.owner);
        const activeOwners = new Set(activeOwnerNames);

        function displayName(owner) {
          return ownerDisplayNames[owner] ?? owner;
        }

        function populateDropdown(select, selectedValue) {
          const useCurrentOnly = currentOwnersOnly.checked;

          const availableOwners = useCurrentOnly
            ? allOwners.filter(owner => activeOwners.has(owner))
            : allOwners;

          select.innerHTML = `<option value="">Choose owner...</option>`;

          availableOwners.forEach(owner => {
            const option = document.createElement("option");
            option.value = owner;
            option.textContent = owner;

            if (owner === selectedValue) {
              option.selected = true;
            }

            select.appendChild(option);
          });

          if (!availableOwners.includes(selectedValue)) {
            select.value = "";
          }
        }

        function refreshDropdowns() {
          const selectedA = ownerASelect.value;
          const selectedB = ownerBSelect.value;

          populateDropdown(ownerASelect, selectedA);
          populateDropdown(ownerBSelect, selectedB);

          render();
        }

        function formatRecord(aWins, bWins, ties) {
          return ties > 0 ? `${aWins}-${bWins}-${ties}` : `${aWins}-${bWins}`;
        }

        function formatGame(game, ownerA, ownerB) {
          if (!game) return "N/A";

          return `${game.year} Week ${game.week}: ${displayName(ownerA)} ${game.ownerAScore.toFixed(2)}, ${displayName(ownerB)} ${game.ownerBScore.toFixed(2)} - Margin ${game.margin.toFixed(2)}`;
        }

        function render() {
          const ownerA = ownerASelect.value;
          const ownerB = ownerBSelect.value;

          const ownerADisplay = displayName(ownerA);
          const ownerBDisplay = displayName(ownerB);

          if (!ownerA || !ownerB) {
            results.innerHTML = "";
            return;
          }

          if (ownerA === ownerB) {
            results.innerHTML = "<p>Please choose two different owners.</p>";
            return;
          }

          const key = `${ownerA}|||${ownerB}`;
          const stats = matchupStats[key];

          if (!stats || stats.gamesPlayed === 0) {
            results.innerHTML = `<p>No matchups found between ${ownerADisplay} and ${ownerBDisplay}.</p>`;
            return;
          }

          results.innerHTML = `
            <h2>${ownerA} vs ${ownerB}</h2>

           <div class="h2h-summary-grid">
  <div class="stat-card">
    <span class="stat-label">All-Time<br>Record</span>
    <span class="stat-value">${formatRecord(stats.ownerAWins, stats.ownerBWins, stats.ties)}</span>
  </div>

  <div class="stat-card">
    <span class="stat-label">Games<br>Played</span>
    <span class="stat-value">${stats.gamesPlayed}</span>
  </div>

  <div class="stat-card">
    <span class="stat-label">Total Points</span>
    <span class="stat-value">${ownerADisplay}: ${stats.ownerAPoints.toFixed(2)}</span>
    <span class="stat-value">${ownerBDisplay}: ${stats.ownerBPoints.toFixed(2)}</span>
  </div>

  <div class="stat-card">
    <span class="stat-label">Average Score</span>
    <span class="stat-value">${ownerADisplay}: ${stats.ownerAAverage.toFixed(2)}</span>
    <span class="stat-value">${ownerBDisplay}: ${stats.ownerBAverage.toFixed(2)}</span>
  </div>

  <div class="stat-card">
    <span class="stat-label">Regular Season Record</span>
    <span class="stat-value">${formatRecord(stats.regular.ownerAWins, stats.regular.ownerBWins, stats.regular.ties)}</span>
  </div>

  <div class="stat-card">
    <span class="stat-label">Playoff Record</span>
    <span class="stat-value">${formatRecord(stats.playoffs.ownerAWins, stats.playoffs.ownerBWins, stats.playoffs.ties)}</span>
  </div>

  <div class="stat-card">
    <span class="stat-label">Consolation Record</span>
    <span class="stat-value">${formatRecord(stats.consolation.ownerAWins, stats.consolation.ownerBWins, stats.consolation.ties)}</span>
  </div>

  <div class="stat-card">
    <span class="stat-label">Biggest ${ownerADisplay} Win</span>
    <span class="stat-value">${stats.biggestOwnerAWin ? stats.biggestOwnerAWin.margin.toFixed(2) : "N/A"}</span>
    <span class="stat-detail">${stats.biggestOwnerAWin ? `<a href="/seasons/${stats.biggestOwnerAWin.year}">${stats.biggestOwnerAWin.year}</a> Week ${stats.biggestOwnerAWin.week}` : ""}</span>
  </div>

  <div class="stat-card">
    <span class="stat-label">Biggest ${ownerBDisplay} Win</span>
    <span class="stat-value">${stats.biggestOwnerBWin ? stats.biggestOwnerBWin.margin.toFixed(2) : "N/A"}</span>
    <span class="stat-detail">${stats.biggestOwnerBWin ? `<a href="/seasons/${stats.biggestOwnerBWin.year}">${stats.biggestOwnerBWin.year}</a> Week ${stats.biggestOwnerBWin.week}` : ""}</span>
  </div>

  <div class="stat-card">
    <span class="stat-label">Closest Game</span>
    <span class="stat-value">${stats.closestGame ? `${stats.closestGame.ownerAScore.toFixed(2)} - ${stats.closestGame.ownerBScore.toFixed(2)}` : "N/A"}</span>
    <span class="stat-detail">${stats.closestGame ? `Margin ${stats.closestGame.margin.toFixed(2)} • <a href="/seasons/${stats.closestGame.year}">${stats.closestGame.year}</a> Week ${stats.closestGame.week}` : ""}</span>
  </div>
</div>
          `;
        }

        currentOwnersOnly.addEventListener("change", refreshDropdowns);
        ownerASelect.addEventListener("change", render);
        ownerBSelect.addEventListener("change", render);

        const params = new URLSearchParams(window.location.search);
        const ownerAFromUrl = params.get("ownerA");
        const ownerBFromUrl = params.get("ownerB");
        if (ownerAFromUrl && ownerBFromUrl) {
          ownerASelect.value = ownerAFromUrl;
          ownerBSelect.value = ownerBFromUrl;
          render();
}
    </script>
  </div>
</Layout>