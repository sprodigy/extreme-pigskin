---
import Layout from "../../layouts/layout.astro";
import { getGameLog } from "../../lib/data";
import { getSeasonList } from "../../lib/stats";

const gameLog = getGameLog();
const seasons = getSeasonList(gameLog);
---
<Layout title="Seasons">
<html>
  <body>
    <h1>Season Explorer &#128197;</h1>


<div class="page-card">
      <p>Select a season:</p>
    <select id="season-select">
      <option value="">Choose year...</option>
      {
        seasons.map(year => (
          <option value={`/seasons/${year}`}>{year}</option>
        ))
      }
    </select>
</div>
    <script>
      const select = document.getElementById("season-select");

      select.addEventListener("change", event => {
        const url = event.target.value;

        if (url) {
          window.location.href = url;
        }
      });
    </script>
  </body>
</html>
</Layout>