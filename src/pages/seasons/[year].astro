---
import { getGameLog } from "../../lib/data";
import * as stats from "../../lib/stats";
import Layout from "../../layouts/layout.astro";

export function getStaticPaths() {
  const gameLog = getGameLog();
  const seasons = stats.getSeasonList(gameLog);

  return seasons.map(year => ({
    params: {
      year: String(year)
    },
    props: {
      year
    }
  }));
}

const gameLog = getGameLog();
const { year } = Astro.props;
const seasons = stats.getSeasonList(gameLog);
const currentYear = Number(year);

const currentIndex = seasons.indexOf(currentYear);

const newerSeason =
  currentIndex > 0
    ? seasons[currentIndex - 1]
    : null;

const olderSeason =
  currentIndex < seasons.length - 1
    ? seasons[currentIndex + 1]
    : null;
const standings = stats.calculateRegularSeasonStandings(gameLog, year);
const games = stats.getGamesForSeason(gameLog, year);
const playoffGames = stats.getPlayoffGamesForSeason(gameLog, year);
const finishers = stats.getSeasonFinishers(gameLog, year);
const topTeamsByWeek = stats.getTopTeamsByWeek(gameLog, year);

const slugifyOwner = stats.slugifyOwner;
---
<Layout title="Season Details">
<html>
  <body>
    <h1>{year} Season</h1>
    <p>
  {
    newerSeason && (
      <a href={`/seasons/${newerSeason}`}>
        &larr; {newerSeason}
      </a>
    )
  }

  {
    newerSeason && olderSeason && " | "
  }

  {
    olderSeason && (
      <a href={`/seasons/${olderSeason}`}>
        {olderSeason} &rarr;
      </a>
    )
  }
</p>

    <label for="season-select">Jump to season:</label>

    <select id="season-select">
      {
        seasons.map(seasonYear => (
          <option
            value={`/seasons/${seasonYear}`}
            selected={seasonYear === year}
          >
            {seasonYear}
          </option>
        ))
      }
    </select>

    <script>
      const select = document.getElementById("season-select");

      select.addEventListener("change", event => {
        window.location.href = event.target.value;
      });
    </script>

    <h2>Season Results</h2>

    {
      finishers.champion && (
        <p>
          Champion:{" "}
          <strong>
            <a href={`/owners/${slugifyOwner(finishers.champion)}`}>
              {finishers.champion}
            </a>
          </strong>
          {" "}
          defeated{" "}
          <a href={`/owners/${slugifyOwner(finishers.runnerUp)}`}>
            {finishers.runnerUp}
          </a>
          {" "}
          {finishers.championScore.toFixed(2)} - {finishers.runnerUpScore.toFixed(2)}
        </p>
      )
    }

    {
      finishers.toiletBowlWinner && (
        <p>
          Toilet Bowl Winner:{" "}
          <strong>
            <a href={`/owners/${slugifyOwner(finishers.toiletBowlWinner)}`}>
              {finishers.toiletBowlWinner}
            </a>
          </strong>
          {" "}
          defeated{" "}
          <a href={`/owners/${slugifyOwner(finishers.toiletBowlLoser)}`}>
            {finishers.toiletBowlLoser}
          </a>
          {" "}
          {finishers.toiletBowlWinnerScore.toFixed(2)} - {finishers.toiletBowlLoserScore.toFixed(2)}
        </p>
      )
    }
<h2>Top Team of the Week</h2>
<div class="table-wrap">
<table>
  <tr>
    <th>Week</th>
    <th>Owner</th>
    <th>Score</th>
    <th>Opponent</th>
    <th>Opponent Score</th>
    <th>Game Type</th>
  </tr>

  {
    topTeamsByWeek.map(row => (
      <tr>
        <td>{row.week}</td>
        <td>
          <a href={`/owners/${slugifyOwner(row.owner)}`}>
            {stats.shortOwnerName(row.owner)}
          </a>
        </td>
        <td>{row.score.toFixed(2)}</td>
        <td>
          <a href={`/owners/${slugifyOwner(row.opponent)}`}>
            {stats.shortOwnerName(row.opponent)}
          </a>
        </td>
        <td>{row.opponentScore.toFixed(2)}</td>
        <td>{row.gameType}</td>
      </tr>
    ))
  }
</table>
</div>
    <h2>Regular Season Standings</h2>
<div class="table-wrap">
    <table>
      <tr>
        <th>Rank</th>
        <th>Owner</th>
        <th>W</th>
        <th>L</th>
        <th>T</th>
        <th>Win %</th>
        <th>PF</th>
        <th>PA</th>
        <th>GP</th>
      </tr>

      {
        standings.map((owner, index) => (
          <tr>
            <td>{index + 1}</td>
            <td>
              <a href={`/owners/${slugifyOwner(owner.owner)}`}>
                {stats.shortOwnerName(owner.owner)}
              </a>
            </td>
            <td>{owner.wins}</td>
            <td>{owner.losses}</td>
            <td>{owner.ties}</td>
            <td>{owner.winPct.toFixed(3)}</td>
            <td>{owner.pointsFor.toFixed(2)}</td>
            <td>{owner.pointsAgainst.toFixed(2)}</td>
            <td>{owner.gamesPlayed}</td>
          </tr>
        ))
      }
    </table>
</div>
<h2>Playoffs & Consolation</h2>
<div class="table-wrap">
<table>
  <tr>
    <th>Week</th>
    <th>Type</th>
    <th>Winner</th>
    <th>Score</th>
    <th>Loser</th>
    <th>Score</th>
  </tr>

  {
    playoffGames.map(game => {
      const team1Won = game.team1Score > game.team2Score;

      const winner = team1Won ? game.team1 : game.team2;
      const loser = team1Won ? game.team2 : game.team1;

      const winnerScore = team1Won ? game.team1Score : game.team2Score;
      const loserScore = team1Won ? game.team2Score : game.team1Score;

      const maxPlayoffWeek = Math.max(...playoffGames.map(row => row.week));

      const gameTypeLabel =
        game.gameType === "P" && game.week === maxPlayoffWeek
          ? "Championship"
          : game.gameType === "P"
            ? "Playoff"
            : "Consolation";

      return (
        <tr>
          <td>{game.week}</td>
          <td>{gameTypeLabel}</td>
          <td>
            <a href={`/owners/${slugifyOwner(winner)}`}>
              {stats.shortOwnerName(winner)}
            </a>
          </td>
          <td>{winnerScore.toFixed(2)}</td>
          <td>
            <a href={`/owners/${slugifyOwner(loser)}`}>
              {stats.shortOwnerName(loser)}
            </a>
          </td>
          <td>{loserScore.toFixed(2)}</td>
        </tr>
      );
    })
  }
</table>
</div>
<h2>All Games</h2>
<div class="table-wrap">
<table>
  <tr>
    <th>Week</th>
    <th>Game Type</th>
    <th>Winner</th>
    <th>Score</th>
    <th>Loser</th>
    <th>Score</th>
  </tr>

  {
    games.map(game => {
      const team1Won = game.team1Score > game.team2Score;

      const winner = team1Won ? game.team1 : game.team2;
      const loser = team1Won ? game.team2 : game.team1;

      const winnerScore = team1Won ? game.team1Score : game.team2Score;
      const loserScore = team1Won ? game.team2Score : game.team1Score;

      return (
        <tr>
          <td>{game.week}</td>
          <td>{game.gameType}</td>
          <td>
            <a href={`/owners/${slugifyOwner(winner)}`}>
              {stats.shortOwnerName(winner)}
            </a>
          </td>
          <td>{winnerScore.toFixed(2)}</td>
          <td>
            <a href={`/owners/${slugifyOwner(loser)}`}>
              {stats.shortOwnerName(loser)}
            </a>
          </td>
          <td>{loserScore.toFixed(2)}</td>
        </tr>
      );
    })
  }
</table>
</div>
  </body>
</html>
</Layout>
