---
import { getGameLog, getOwners } from "../lib/data";
import {
  calculateOwnerRecords,
  calculateChampionships,
  calculateToiletBowls,
  slugifyOwner
} from "../lib/stats";
import "../styles/style.css";
import Nav from "../components/Nav.astro";

const gameLog = getGameLog();
const owners = getOwners();

const activeOwners = new Set(
  owners
    .filter(owner => owner.status === "ACTIVE")
    .map(owner => owner.owner)
);

const allStandings = calculateOwnerRecords(gameLog);
const regularStandings = calculateOwnerRecords(
  gameLog.filter(game => game.gameType === "R")
);
const playoffStandings = calculateOwnerRecords(
  gameLog.filter(game => game.gameType === "P")
);
const consolationStandings = calculateOwnerRecords(
  gameLog.filter(game => game.gameType === "C")
);

const championships = calculateChampionships(gameLog);
const toiletBowls = calculateToiletBowls(gameLog);

const allOwners = new Set([
  ...allStandings.map(owner => owner.owner),
  ...regularStandings.map(owner => owner.owner),
  ...playoffStandings.map(owner => owner.owner),
  ...consolationStandings.map(owner => owner.owner)
]);

const standingsByOwner = Array.from(allOwners)
  .sort()
  .map(ownerName => {
    const all = allStandings.find(row => row.owner === ownerName);
    const regular = regularStandings.find(row => row.owner === ownerName);
    const playoffs = playoffStandings.find(row => row.owner === ownerName);
    const consolation = consolationStandings.find(row => row.owner === ownerName);

    return {
      owner: ownerName,
      all,
      regular,
      playoffs,
      consolation
    };
  });

function emptyRecord(ownerName) {
  return {
    owner: ownerName,
    wins: 0,
    losses: 0,
    ties: 0,
    winPct: 0,
    pointsFor: 0,
    pointsAgainst: 0,
    gamesPlayed: 0
  };
}
---

<html>
  <body>
    <Nav />

    <h1>Fantasy League History</h1>

    <h2 id="standings-title">All-Time Standings</h2>

    <label for="owner-filter">Owners:</label>

    <select id="owner-filter">
      <option value="all">All Owners</option>
      <option value="active">Active Owners</option>
    </select>

    <label for="game-type-filter">Game Type:</label>

    <select id="game-type-filter">
      <option value="all">All Games</option>
      <option value="regular">Regular Season</option>
      <option value="playoffs">Playoffs</option>
      <option value="consolation">Consolation</option>
    </select>

    <table id="standings-table">
      <tr>
        <th data-sort="owner">Owner</th>
        <th data-sort="wins">W</th>
        <th data-sort="losses">L</th>
        <th data-sort="ties">T</th>
        <th data-sort="winPct">Pct</th>
        <th data-sort="pointsFor">PF</th>
        <th data-sort="pointsAgainst">PA</th>
        <th data-sort="gamesPlayed">GP</th>
        <th data-sort="championships" title="Championships">&#127942;</th>
        <th data-sort="runnerUps" title="Runner-Up">&#129352;</th>
        <th data-sort="toiletBowls" title="Toilet Bowl Wins">&#128701;</th>
      </tr>

      {
        standingsByOwner.map(ownerGroup => {
          const all = ownerGroup.all ?? emptyRecord(ownerGroup.owner);
          const regular = ownerGroup.regular ?? emptyRecord(ownerGroup.owner);
          const playoffs = ownerGroup.playoffs ?? emptyRecord(ownerGroup.owner);
          const consolation = ownerGroup.consolation ?? emptyRecord(ownerGroup.owner);

          const ownerChampionships =
            championships[ownerGroup.owner]?.championships ?? 0;

          const ownerRunnerUps =
            championships[ownerGroup.owner]?.runnerUps ?? 0;

          const ownerToiletBowls =
            toiletBowls[ownerGroup.owner] ?? 0;

          return (
            <tr
              data-active={activeOwners.has(ownerGroup.owner) ? "true" : "false"}

              data-all-wins={all.wins}
              data-all-losses={all.losses}
              data-all-ties={all.ties}
              data-all-winpct={all.winPct}
              data-all-pointsfor={all.pointsFor}
              data-all-pointsagainst={all.pointsAgainst}
              data-all-gamesplayed={all.gamesPlayed}

              data-regular-wins={regular.wins}
              data-regular-losses={regular.losses}
              data-regular-ties={regular.ties}
              data-regular-winpct={regular.winPct}
              data-regular-pointsfor={regular.pointsFor}
              data-regular-pointsagainst={regular.pointsAgainst}
              data-regular-gamesplayed={regular.gamesPlayed}

              data-playoffs-wins={playoffs.wins}
              data-playoffs-losses={playoffs.losses}
              data-playoffs-ties={playoffs.ties}
              data-playoffs-winpct={playoffs.winPct}
              data-playoffs-pointsfor={playoffs.pointsFor}
              data-playoffs-pointsagainst={playoffs.pointsAgainst}
              data-playoffs-gamesplayed={playoffs.gamesPlayed}

              data-consolation-wins={consolation.wins}
              data-consolation-losses={consolation.losses}
              data-consolation-ties={consolation.ties}
              data-consolation-winpct={consolation.winPct}
              data-consolation-pointsfor={consolation.pointsFor}
              data-consolation-pointsagainst={consolation.pointsAgainst}
              data-consolation-gamesplayed={consolation.gamesPlayed}

              data-owner={ownerGroup.owner}
              data-championships={ownerChampionships}
              data-runnerups={ownerRunnerUps}
              data-toiletbowls={ownerToiletBowls}
            >
              <td>
                <a href={`/owners/${slugifyOwner(ownerGroup.owner)}`}>
                  {ownerGroup.owner}
                </a>
              </td>
              <td class="wins">{all.wins}</td>
              <td class="losses">{all.losses}</td>
              <td class="ties">{all.ties}</td>
              <td class="winPct">{all.winPct.toFixed(3)}</td>
              <td class="pointsFor">{Math.round(all.pointsFor).toLocaleString()}</td>
              <td class="pointsAgainst">{Math.round(all.pointsAgainst).toLocaleString()}</td>
              <td class="gamesPlayed">{all.gamesPlayed}</td>
              <td>{ownerChampionships}</td>
              <td>{ownerRunnerUps}</td>
              <td>{ownerToiletBowls}</td>
            </tr>
          );
        })
      }
    </table>

    <script>
      const ownerFilter = document.getElementById("owner-filter");
      const gameTypeFilter = document.getElementById("game-type-filter");
      const table = document.getElementById("standings-table");
      const headers = table.querySelectorAll("th[data-sort]");
      const standingsTitle = document.getElementById("standings-title");

      let sortColumn = "winPct";
      let sortDirection = "desc";

      const gameTypeLabels = {
        all: "All Games",
        regular: "Regular Season",
        playoffs: "Playoffs",
        consolation: "Consolation"
      };

      function updateTitle() {
        standingsTitle.textContent =
          `All-Time Standings (${gameTypeLabels[gameTypeFilter.value]})`;
      }

      function getRowValue(row, column) {
        const gameType = gameTypeFilter.value;

        if (column === "owner") {
          return row.dataset.owner;
        }

        if (
          column === "championships" ||
          column === "runnerUps" ||
          column === "toiletBowls"
        ) {
          return Number(row.dataset[column.toLowerCase()]);
        }

          return Number(row.getAttribute(`data-${gameType}-${column.toLowerCase()}`));
      }

function updateDisplayedStats() {
  const gameType = gameTypeFilter.value;
  const rows = table.querySelectorAll("tr[data-active]");

  rows.forEach(row => {
    row.querySelector(".wins").textContent =
      row.getAttribute(`data-${gameType}-wins`);

    row.querySelector(".losses").textContent =
      row.getAttribute(`data-${gameType}-losses`);

    row.querySelector(".ties").textContent =
      row.getAttribute(`data-${gameType}-ties`);

    row.querySelector(".winPct").textContent =
      Number(row.getAttribute(`data-${gameType}-winpct`)).toFixed(3);

    row.querySelector(".pointsFor").textContent =
      Math.round(Number(row.getAttribute(`data-${gameType}-pointsfor`))).toLocaleString();

    row.querySelector(".pointsAgainst").textContent =
      Math.round(Number(row.getAttribute(`data-${gameType}-pointsagainst`))).toLocaleString();

    row.querySelector(".gamesPlayed").textContent =
      row.getAttribute(`data-${gameType}-gamesplayed`);
  });
}

      function applyOwnerFilter() {
        const rows = table.querySelectorAll("tr[data-active]");
        const value = ownerFilter.value;

        rows.forEach(row => {
          const isActive = row.dataset.active === "true";

          if (value === "all") {
            row.style.display = "";
          } else if (value === "active" && isActive) {
            row.style.display = "";
          } else {
            row.style.display = "none";
          }
        });
      }

      function sortTable(column) {
        const rows = Array.from(table.querySelectorAll("tr[data-active]"));

        if (sortColumn === column) {
          sortDirection = sortDirection === "asc" ? "desc" : "asc";
        } else {
          sortColumn = column;
          sortDirection = column === "owner" ? "asc" : "desc";
        }

        rows.sort((a, b) => {
          const aValue = getRowValue(a, column);
          const bValue = getRowValue(b, column);

          if (column === "owner") {
            return sortDirection === "asc"
              ? aValue.localeCompare(bValue)
              : bValue.localeCompare(aValue);
          }

          return sortDirection === "asc"
            ? aValue - bValue
            : bValue - aValue;
        });

        rows.forEach(row => table.appendChild(row));

        applyOwnerFilter();
      }

      function refreshTable() {
        updateTitle();
        updateDisplayedStats();
        sortTable(sortColumn);
        applyOwnerFilter();
      }

      ownerFilter.addEventListener("change", applyOwnerFilter);
      gameTypeFilter.addEventListener("change", refreshTable);

      headers.forEach(header => {
        header.addEventListener("click", () => {
          sortTable(header.dataset.sort);
        });
      });

      updateTitle();
    </script>
  </body>
</html>