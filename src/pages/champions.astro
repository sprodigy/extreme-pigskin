---
import { getGameLog } from "../lib/data";
import { getChampionshipGames, slugifyOwner } from "../lib/stats";
import "../styles/style.css";
import Nav from "../components/Nav.astro";

const gameLog = getGameLog();
const championshipGames = getChampionshipGames(gameLog);
---

<html>
  <body>
    <Nav />

    <h1>&#127942; Championship History</h1>

    <table>
      <tr>
        <th>Year</th>
        <th>Champion</th>
        <th>Runner-Up</th>
        <th>Score</th>
        <th>Margin</th>
      </tr>

      {
        championshipGames.map(game => (
          <tr>
            <td>{game.year}</td>

            <td>
              {
                game.isSharedChampionship
                  ? game.champion.split(" / ").map((owner, index, arr) => (
                      <>
                        <a href={`/owners/${slugifyOwner(owner)}`}>
                          {owner}
                        </a>
                        {index < arr.length - 1 ? " / " : ""}
                      </>
                    ))
                  : (
                    <a href={`/owners/${slugifyOwner(game.champion)}`}>
                      {game.champion}
                    </a>
                  )
              }
            </td>

            <td>
              {
                game.runnerUp === "N/A"
                  ? "N/A"
                  : (
                    <a href={`/owners/${slugifyOwner(game.runnerUp)}`}>
                      {game.runnerUp}
                    </a>
                  )
              }
            </td>

            <td>
              {game.championScore.toFixed(2)} - {game.runnerUpScore.toFixed(2)}
            </td>

            <td>
              {game.margin.toFixed(2)}
            </td>
          </tr>
        ))
      }
    </table>

    <p>
      <strong>* 2022 Note:</strong> The championship was declared a shared title
      following the cancellation of the Buffalo Bills vs Cincinnati Bengals game
      after the Damar Hamlin incident. Both finalists are credited with a league
      championship.
    </p>

  </body>
</html>