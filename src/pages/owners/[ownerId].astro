---
import Layout from "../../layouts/layout.astro";
import OwnerPointsChart from "../../components/OwnerPointsChart.astro";
import { getGameLog } from "../../lib/data";
import {
  getOwnerList,
  getGamesForOwner,
  getOwnerRecord,
  calculateChampionships,
  getOwnerChampionshipResults,
  getOpponentRecords,
  getOwnerQuickFacts,
  getOwnerSeasonRecords,
  shortOwnerName
} from "../../lib/stats";

export function getStaticPaths() {
  const gameLog = getGameLog();
  const owners = getOwnerList(gameLog);

  return owners.map(owner => ({
    params: {
      ownerId: owner.ownerId
    },
    props: {
      ownerName: owner.owner
    }
  }));
}

const gameLog = getGameLog();
const { ownerName } = Astro.props;
const regularSeasonRecords =
  getOwnerSeasonRecords(gameLog, ownerName, "R");
const playoffRecords =
  getOwnerSeasonRecords(gameLog, ownerName, "P");
const regularSeasonChartData = [...regularSeasonRecords.seasons]
  .sort((a, b) => a.year - b.year)
  .map(season => ({
    year: season.year,
    pointsFor: Math.round(season.pointsFor)
  }));

const chartLabels = regularSeasonChartData.map(row => row.year);
const chartPoints = regularSeasonChartData.map(row => row.pointsFor);
const record = getOwnerRecord(gameLog, ownerName);
const games = getGamesForOwner(gameLog, ownerName);
const quickFacts = getOwnerQuickFacts(gameLog, ownerName);

const championships = calculateChampionships(gameLog);

const ownerTitles =
  championships[ownerName]?.championships ?? 0;

const ownerRunnerUps =
  championships[ownerName]?.runnerUps ?? 0;

const championshipResults =
  getOwnerChampionshipResults(gameLog, ownerName);

const rivalries =
  getOpponentRecords(gameLog, ownerName);

const biggestRival = rivalries.length > 0 ? rivalries[0] : null;

const biggestRivalUrl = biggestRival
  ? `/head-to-head?ownerA=${encodeURIComponent(ownerName)}&ownerB=${encodeURIComponent(biggestRival.opponent)}`
  : null;

const sortedGames = [...games].sort((a, b) => {
  if (b.year !== a.year) return b.year - a.year;
  return b.week - a.week;

  
});
---
<Layout title="Owner Deep Dive">
<html>
  <body>
<section class="owner-hero">
  <h1>{ownerName} &#128100;</h1>

  <div class="owner-summary-grid">
    <div class="stat-card">
      <span class="stat-label">Career Record</span>
      <span class="stat-value">
        {record.wins}-{record.losses}
        {record.ties > 0 ? `-${record.ties}` : ""}
      </span>
    </div>

    <div class="stat-card">
      <span class="stat-label">Win %</span>
      <span class="stat-value">{record.winPct.toFixed(3)}</span>
    </div>

    <div class="stat-card">
      <span class="stat-label">Games Played</span>
      <span class="stat-value">{record.gamesPlayed}</span>
    </div>

    <div class="stat-card">
      <span class="stat-label">Points For</span>
      <span class="stat-value">{Math.round(record.pointsFor).toLocaleString()}</span>
    </div>

    <div class="stat-card">
      <span class="stat-label">Points Against</span>
      <span class="stat-value">{Math.round(record.pointsAgainst).toLocaleString()}</span>
    </div>
  </div>

  <div class="achievement-row">
    <span class="achievement-pill">&#127942; {ownerTitles} Championships</span>
    <span class="achievement-pill">&#129352; {ownerRunnerUps} Runner-Ups</span>
    <span class="achievement-pill">&#128701; {quickFacts.lastPlaceFinishes} Last-Place Finishes</span>
  </div>


</section>

<h2>Quick Facts</h2>

<div class="quick-facts-grid">
  <div class="stat-card">
    <span class="stat-label">Seasons Played</span>
    <span class="stat-value">{quickFacts.seasonsPlayed}</span>
  </div>

  <div class="stat-card">
    <span class="stat-label">Best Finish</span>
    <span class="stat-value">
      {
        quickFacts.bestFinish
          ? `${quickFacts.bestFinish.finish}${quickFacts.bestFinish.finish === 1 ? "st" : quickFacts.bestFinish.finish === 2 ? "nd" : quickFacts.bestFinish.finish === 3 ? "rd" : "th"}`
          : "N/A"
      }
    </span>
  </div>

  <div class="stat-card">
    <span class="stat-label">Postseason Appearances</span>
    <span class="stat-value">{quickFacts.postseasonAppearances}</span>
  </div>

  <div class="stat-card">
    <span class="stat-label">Championship Appearances</span>
    <span class="stat-value">{quickFacts.championshipAppearances}</span>
  </div>

  <div class="stat-card">
    <span class="stat-label">Toilet Bowl Appearances</span>
    <span class="stat-value">{quickFacts.toiletBowlAppearances}</span>
  </div>

  {
  biggestRival && (
    <div class="stat-card">
      <span class="stat-label">Biggest Rival</span>
      <span class="stat-value">
        <a href={biggestRivalUrl}>
          {shortOwnerName(biggestRival.opponent)}
          {" "}
          ({biggestRival.wins}-{biggestRival.losses}
          {biggestRival.ties > 0 ? `-${biggestRival.ties}` : ""})
        </a>
      </span>
    </div>
  )
}

  <div class="stat-card">
    <span class="stat-label">Swept League</span>
    <span class="stat-value">{quickFacts.sweptLeague.length}</span>
  </div>

  <div class="stat-card">
    <span class="stat-label">Swept by League</span>
    <span class="stat-value">{quickFacts.sweptByLeague.length}</span>
  </div>

  <div class="stat-card">
    <span class="stat-label">Best Regular Season</span>
    <span class="stat-value">
      {quickFacts.bestRegularSeason.wins}-{quickFacts.bestRegularSeason.losses}
      {quickFacts.bestRegularSeason.ties > 0 ? `-${quickFacts.bestRegularSeason.ties}` : ""}
      ({quickFacts.bestRegularSeason.year})
    </span>
  </div>

  <div class="stat-card">
    <span class="stat-label">Worst Regular Season</span>
    <span class="stat-value">
      {quickFacts.worstRegularSeason.wins}-{quickFacts.worstRegularSeason.losses}
      {quickFacts.worstRegularSeason.ties > 0 ? `-${quickFacts.worstRegularSeason.ties}` : ""}
      ({quickFacts.worstRegularSeason.year})
    </span>
  </div>

  <div class="stat-card">
    <span class="stat-label">Highest Scoring Week</span>
    <span class="stat-value">
      {quickFacts.highestScoringWeek.score.toFixed(2)}
    </span>
  </div>

  <div class="stat-card">
    <span class="stat-label">Lowest Scoring Week</span>
    <span class="stat-value">
      {quickFacts.lowestScoringWeek.score.toFixed(2)}
    </span>
  </div>

  <div class="stat-card">
    <span class="stat-label">Longest Win Streak</span>
    <span class="stat-value">{quickFacts.longestWinningStreak.games}</span>
  </div>

  <div class="stat-card">
    <span class="stat-label">Longest Losing Streak</span>
    <span class="stat-value">{quickFacts.longestLosingStreak.games}</span>
  </div>
</div>

<h2>Regular Season Record by Year</h2>
<div class="table-wrap">
<table>
  <tr>
    <th>Year</th>
    <th>W</th>
    <th>L</th>
    <th>T</th>
    <th>Pct</th>
    <th>PF</th>
    <th>PA</th>
    <th>GP</th>
  </tr>

  {
    regularSeasonRecords.seasons.map(season => (
      <tr>
        <td><a href={`/seasons/${season.year}`}>{season.year}</a></td>
        <td>{season.wins}</td>
        <td>{season.losses}</td>
        <td>{season.ties}</td>
        <td>{season.winPct.toFixed(3)}</td>
        <td>{Math.round(season.pointsFor).toLocaleString()}</td>
        <td>{Math.round(season.pointsAgainst).toLocaleString()}</td>
        <td>{season.gamesPlayed}</td>
      </tr>
    ))
  }

<tr class="total-row">
  <td>Total</td>
  <td>{regularSeasonRecords.total.wins}</td>
  <td>{regularSeasonRecords.total.losses}</td>
  <td>{regularSeasonRecords.total.ties}</td>
  <td>{regularSeasonRecords.total.winPct.toFixed(3)}</td>
  <td>{Math.round(regularSeasonRecords.total.pointsFor).toLocaleString()}</td>
  <td>{Math.round(regularSeasonRecords.total.pointsAgainst).toLocaleString()}</td>
  <td>{regularSeasonRecords.total.gamesPlayed}</td>
</tr>
</table>
</div>

<h2>Playoff Record by Year</h2>

<div class="table-wrap">
<table>
  <tr>
    <th>Year</th>
    <th>W</th>
    <th>L</th>
    <th>T</th>
    <th>Pct</th>
    <th>PF</th>
    <th>PA</th>
    <th>GP</th>
  </tr>

  {
    playoffRecords.seasons.map(season => (
      <tr>
        <td><a href={`/seasons/${season.year}`}>{season.year}</a></td>
        <td>{season.wins}</td>
        <td>{season.losses}</td>
        <td>{season.ties}</td>
        <td>{season.winPct.toFixed(3)}</td>
        <td>{Math.round(season.pointsFor).toLocaleString()}</td>
        <td>{Math.round(season.pointsAgainst).toLocaleString()}</td>
        <td>{season.gamesPlayed}</td>
      </tr>
    ))
  }

  <tr class="total-row">
  <td>Total</td>
  <td>{playoffRecords.total.wins}</td>
  <td>{playoffRecords.total.losses}</td>
  <td>{playoffRecords.total.ties}</td>
  <td>{playoffRecords.total.winPct.toFixed(3)}</td>
  <td>{Math.round(playoffRecords.total.pointsFor).toLocaleString()}</td>
  <td>{Math.round(playoffRecords.total.pointsAgainst).toLocaleString()}</td>
  <td>{playoffRecords.total.gamesPlayed}</td>
</tr>
</table>
    <h2>Recent Games</h2>

    <table>
      <tr>
        <th>Year</th>
        <th>Week</th>
        <th>Opponent</th>
        <th>Score</th>
        <th>Result</th>
      </tr>

      {
        sortedGames.slice(0, 20).map(game => {
          const isTeam1 = game.team1 === ownerName;

          const ownerScore = isTeam1 ? game.team1Score : game.team2Score;
          const opponent = isTeam1 ? game.team2 : game.team1;
          const opponentScore = isTeam1 ? game.team2Score : game.team1Score;

          let result = "T";

          if (ownerScore > opponentScore) {
            result = "W";
          } else if (ownerScore < opponentScore) {
            result = "L";
          }

          return (
            <tr>
              <td>{game.year}</td>
              <td>{game.week}</td>
              <td>{opponent}</td>
              <td>{ownerScore.toFixed(2)} - {opponentScore.toFixed(2)}</td>
              <td>{result}</td>
            </tr>
          );
        })
      }
    </table>
    </div>
  </body>
</html>
</Layout>