---
import "../../styles/style.css";
import Nav from "../../components/Nav.astro";
import { getGameLog } from "../../lib/data";
import {
  getOwnerList,
  getGamesForOwner,
  getOwnerRecord,
  calculateChampionships,
  getOwnerChampionshipResults,
  getOpponentRecords,
  getOwnerQuickFacts,
  getOwnerSeasonRecords
} from "../../lib/stats";

export function getStaticPaths() {
  const gameLog = getGameLog();
  const owners = getOwnerList(gameLog);

  return owners.map(owner => ({
    params: {
      ownerId: owner.ownerId
    },
    props: {
      ownerName: owner.owner
    }
  }));
}

const gameLog = getGameLog();
const { ownerName } = Astro.props;
const regularSeasonRecords =
  getOwnerSeasonRecords(gameLog, ownerName, "R");
const playoffRecords =
  getOwnerSeasonRecords(gameLog, ownerName, "P");

const record = getOwnerRecord(gameLog, ownerName);
const games = getGamesForOwner(gameLog, ownerName);
const quickFacts = getOwnerQuickFacts(gameLog, ownerName);

const championships = calculateChampionships(gameLog);

const ownerTitles =
  championships[ownerName]?.championships ?? 0;

const ownerRunnerUps =
  championships[ownerName]?.runnerUps ?? 0;

const championshipResults =
  getOwnerChampionshipResults(gameLog, ownerName);

const rivalries =
  getOpponentRecords(gameLog, ownerName);

const sortedGames = [...games].sort((a, b) => {
  if (b.year !== a.year) return b.year - a.year;
  return b.week - a.week;

  
});
---

<html>
  <body>
    <Nav />
    <h1>{ownerName}</h1>

    <h2>Quick Facts</h2>

    <ul>
      <li>Seasons Played: <strong>{quickFacts.seasonsPlayed}</strong></li>

      <li>
        Best Finish:
        <strong>
          {
            quickFacts.bestFinish
              ? `${quickFacts.bestFinish.finish}${quickFacts.bestFinish.finish === 1 ? "st" : quickFacts.bestFinish.finish === 2 ? "nd" : quickFacts.bestFinish.finish === 3 ? "rd" : "th"} in ${quickFacts.bestFinish.year}`
              : "N/A"
          }
        </strong>
      </li>

      <li>Postseason Appearances: <strong>{quickFacts.postseasonAppearances}</strong></li>
      <li>Championship Appearances: <strong>{quickFacts.championshipAppearances}</strong></li>
      <li>Toilet Bowl Appearances: <strong>{quickFacts.toiletBowlAppearances}</strong></li>
      <li>Toilet Bowls Won: <strong>{quickFacts.toiletBowlsWon}</strong></li>
      <li>Swept the League: <strong>{quickFacts.sweptLeague.length}</strong></li>
      <li>Swept by the League: <strong>{quickFacts.sweptByLeague.length}</strong></li>

      <li>
        Best Regular Season:
        <strong>
          {quickFacts.bestRegularSeason.wins}-{quickFacts.bestRegularSeason.losses}
          {quickFacts.bestRegularSeason.ties > 0 ? `-${quickFacts.bestRegularSeason.ties}` : ""}
          in {quickFacts.bestRegularSeason.year}
        </strong>
      </li>

      <li>
        Worst Regular Season:
        <strong>
          {quickFacts.worstRegularSeason.wins}-{quickFacts.worstRegularSeason.losses}
          {quickFacts.worstRegularSeason.ties > 0 ? `-${quickFacts.worstRegularSeason.ties}` : ""}
          in {quickFacts.worstRegularSeason.year}
        </strong>
      </li>

      <li>
        Highest Scoring Week:
        <strong>
          {quickFacts.highestScoringWeek.score.toFixed(2)}
          vs {quickFacts.highestScoringWeek.opponent}
          ({quickFacts.highestScoringWeek.year}, Week {quickFacts.highestScoringWeek.week})
        </strong>
      </li>

      <li>
        Lowest Scoring Week:
        <strong>
          {quickFacts.lowestScoringWeek.score.toFixed(2)}
          vs {quickFacts.lowestScoringWeek.opponent}
          ({quickFacts.lowestScoringWeek.year}, Week {quickFacts.lowestScoringWeek.week})
        </strong>
      </li>

      <li>
        Longest Winning Streak:
        <strong>{quickFacts.longestWinningStreak.games}</strong>
      </li>

      <li>
        Longest Losing Streak:
        <strong>{quickFacts.longestLosingStreak.games}</strong>
      </li>
    </ul>

    <h2>League Achievements</h2>

    <p>Championships: <strong>{ownerTitles}</strong></p>
    <p>Runner-Ups: <strong>{ownerRunnerUps}</strong></p>

    {
      championshipResults.championshipSeasons.length > 0 && (
        <p>
          Championship Seasons:{" "}
          <strong>{championshipResults.championshipSeasons.join(", ")}</strong>
        </p>
      )
    }

    {
      championshipResults.runnerUpSeasons.length > 0 && (
        <p>
          Runner-Up Seasons:{" "}
          <strong>{championshipResults.runnerUpSeasons.join(", ")}</strong>
        </p>
      )
    }

    <h2>All-Time Record</h2>

    <p>
      {record.wins}-{record.losses}
      {record.ties > 0 ? `-${record.ties}` : ""}
      ({record.winPct.toFixed(3)})
    </p>

    <p>Games Played: {record.gamesPlayed}</p>
    <p>Points For: {record.pointsFor.toFixed(2)}</p>
    <p>Points Against: {record.pointsAgainst.toFixed(2)}</p>

    <h2>Rivalries</h2>

    <table>
      <tr>
        <th>Opponent</th>
        <th>Record</th>
        <th>Games</th>
      </tr>

      {
        rivalries.map(rival => (
          <tr>
            <td>{rival.opponent}</td>
            <td>
              {rival.wins}-{rival.losses}
              {rival.ties > 0 ? `-${rival.ties}` : ""}
            </td>
            <td>{rival.gamesPlayed}</td>
          </tr>
        ))
      }
    </table>
<h2>Regular Season Record by Year</h2>

<table>
  <tr>
    <th>Year</th>
    <th>W</th>
    <th>L</th>
    <th>T</th>
    <th>Pct</th>
    <th>PF</th>
    <th>PA</th>
    <th>GP</th>
  </tr>

  {
    regularSeasonRecords.seasons.map(season => (
      <tr>
        <td><a href={`/seasons/${season.year}`}>{season.year}</a></td>
        <td>{season.wins}</td>
        <td>{season.losses}</td>
        <td>{season.ties}</td>
        <td>{season.winPct.toFixed(3)}</td>
        <td>{Math.round(season.pointsFor).toLocaleString()}</td>
        <td>{Math.round(season.pointsAgainst).toLocaleString()}</td>
        <td>{season.gamesPlayed}</td>
      </tr>
    ))
  }

<tr class="total-row">
  <td>Total</td>
  <td>{regularSeasonRecords.total.wins}</td>
  <td>{regularSeasonRecords.total.losses}</td>
  <td>{regularSeasonRecords.total.ties}</td>
  <td>{regularSeasonRecords.total.winPct.toFixed(3)}</td>
  <td>{Math.round(regularSeasonRecords.total.pointsFor).toLocaleString()}</td>
  <td>{Math.round(regularSeasonRecords.total.pointsAgainst).toLocaleString()}</td>
  <td>{regularSeasonRecords.total.gamesPlayed}</td>
</tr>
</table>

<h2>Playoff Record by Year</h2>

<table>
  <tr>
    <th>Year</th>
    <th>W</th>
    <th>L</th>
    <th>T</th>
    <th>Pct</th>
    <th>PF</th>
    <th>PA</th>
    <th>GP</th>
  </tr>

  {
    playoffRecords.seasons.map(season => (
      <tr>
        <td><a href={`/seasons/${season.year}`}>{season.year}</a></td>
        <td>{season.wins}</td>
        <td>{season.losses}</td>
        <td>{season.ties}</td>
        <td>{season.winPct.toFixed(3)}</td>
        <td>{Math.round(season.pointsFor).toLocaleString()}</td>
        <td>{Math.round(season.pointsAgainst).toLocaleString()}</td>
        <td>{season.gamesPlayed}</td>
      </tr>
    ))
  }

  <tr class="total-row">
  <td>Total</td>
  <td>{playoffRecords.total.wins}</td>
  <td>{playoffRecords.total.losses}</td>
  <td>{playoffRecords.total.ties}</td>
  <td>{playoffRecords.total.winPct.toFixed(3)}</td>
  <td>{Math.round(playoffRecords.total.pointsFor).toLocaleString()}</td>
  <td>{Math.round(playoffRecords.total.pointsAgainst).toLocaleString()}</td>
  <td>{playoffRecords.total.gamesPlayed}</td>
</tr>
</table>
    <h2>Recent Games</h2>

    <table>
      <tr>
        <th>Year</th>
        <th>Week</th>
        <th>Opponent</th>
        <th>Score</th>
        <th>Result</th>
      </tr>

      {
        sortedGames.slice(0, 20).map(game => {
          const isTeam1 = game.team1 === ownerName;

          const ownerScore = isTeam1 ? game.team1Score : game.team2Score;
          const opponent = isTeam1 ? game.team2 : game.team1;
          const opponentScore = isTeam1 ? game.team2Score : game.team1Score;

          let result = "T";

          if (ownerScore > opponentScore) {
            result = "W";
          } else if (ownerScore < opponentScore) {
            result = "L";
          }

          return (
            <tr>
              <td>{game.year}</td>
              <td>{game.week}</td>
              <td>{opponent}</td>
              <td>{ownerScore.toFixed(2)} - {opponentScore.toFixed(2)}</td>
              <td>{result}</td>
            </tr>
          );
        })
      }
    </table>
    
  </body>
</html>